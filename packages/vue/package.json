{
  "name": "@mrcatz/datatable-vue",
  "version": "0.1.0",
  "description": "DataTable + Form Builder + CRUD untuk Vue 3 / Nuxt 4 dengan Tailwind CSS v4 & daisyUI 5",
  "keywords": [
    "vue",
    "nuxt",
    "datatable",
    "crud",
    "form-builder",
    "daisyui",
    "tailwindcss",
    "tanstack-query",
    "mrcatz"
  ],
  "license": "MIT",
  "author": "Ryan N.R.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrc4tz/mrcatz-js-datatables.git"
  },
  "homepage": "https://github.com/mrc4tz/mrcatz-js-datatables#readme",
  "bugs": {
    "url": "https://github.com/mrc4tz/mrcatz-js-datatables/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/editor.js",
    "./dist/editor-advanced.js",
    "./dist/map.js"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./editor-advanced": {
      "types": "./dist/editor-advanced.d.ts",
      "default": "./dist/editor-advanced.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "default": "./dist/map.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun --bun vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mrcatz/datatable-core": "^0.1.0"
  },
  "peerDependencies": {
    "@tanstack/vue-query": ">=5",
    "vue": ">=3.5",
    "vue-router": ">=4",
    "quill": ">=2",
    "tinymce": ">=7",
    "leaflet": ">=1.9",
    "tailwindcss": ">=4",
    "daisyui": ">=5"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    },
    "quill": {
      "optional": true
    },
    "tinymce": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "quill": "^2.0.3",
    "tinymce": "^7.9.3"
  }
}
